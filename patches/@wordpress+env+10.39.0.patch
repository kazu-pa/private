 const os = require( 'os' );
 
+/**
+ * Linux user/group names in Docker RUN lines must be a single shell word.
+ * Windows display names (e.g. "kazuki shibata") break groupadd/useradd and leave
+ * no home dir, so Composer tries to use /.composer and fails.
+ *
+ * @param {string} username Raw username from os.userInfo().
+ * @return {string} Safe name for use in Dockerfile and /home/<name>.
+ */
+function sanitizeDockerUsername( username ) {
+	const cleaned = String( username )
+		.replace( /\\/g, '_' )
+		.replace( /[^a-zA-Z0-9_-]/g, '_' )
+		.replace( /_+/g, '_' )
+		.replace( /^_+|_+$/g, '' );
+	return cleaned.length > 0 ? cleaned : 'wp-env-user';
+}
